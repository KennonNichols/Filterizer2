<filterizer2:FilterizerWindow x:Class="Filterizer2.Windows.FilterWindow"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:filterizer2="clr-namespace:Filterizer2"
                               xmlns:windows="clr-namespace:Filterizer2.Windows"
                               mc:Ignorable="d"
                               Title="Filter Builder" Height="600" Width="1100">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Search Tags:" VerticalAlignment="Center"/>
                <TextBox Name="TagFilterTextBox" VerticalAlignment="Center" Grid.Column="1" TextChanged="TagFilterTextBox_TextChanged" 
                         PreviewTextInput="SearchBox_PreviewTextInput"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         DataObject.Pasting="SearchBox_Pasting"/>
            </Grid>
            <ListBox Grid.Row="1" Name="TagsListBox" SelectionMode="Single"
                      SelectionChanged="TagsListBox_SelectionChanged"
                      MouseDoubleClick="TagsListBox_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type filterizer2:TagItem}">
                        <TextBlock Text="{Binding Name}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding DisplayColorBrush}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <windows:TagDetailsControl x:Name="TagDetailsControl" DefaultBorderBrush="Gray"/>
            <Border Grid.Row="1" Margin="0, 10, 0, 0" BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                <ListBox Name="FilterListBox" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type filterizer2:TagFilter}">
                            <Grid Background="{Binding BGColor}" Width="Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Click="DeleteFilter" VerticalAlignment="Center" MaxHeight="18" Margin="10,0,0,0" Tag="{Binding Path=.}" ToolTip="Click to remove this specific tag from the filter." Content="Remove"/>
                                <Button Grid.Column="1" Click="InvertFilter" VerticalAlignment="Center" MaxHeight="18" Margin="10,0" Tag="{Binding Path=.}" ToolTip="Click to invert tag filtering logic. White background = whitelist, black background = blacklist." Content="Invert"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Padding="3" Text="{Binding Summary}" Background="{Binding BGColor}" Foreground="{Binding FGColor}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</filterizer2:FilterizerWindow>