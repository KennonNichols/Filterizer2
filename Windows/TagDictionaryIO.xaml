<Window x:Class="Filterizer2.Windows.TagDictionaryIO"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Filterizer2.Windows"
        mc:Ignorable="d"
        Title="TagDictionaryIO" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" x:Name="Readout" Margin="10" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Export to readout from db." Margin="10" Padding="3" Name="ExportButton" Click="ExportButton_OnClick"/>
            <Button Content="Import from readout to db." Margin="10" Padding="3" Name="ImportButton" Click="ImportButton_OnClick"/>
            <TextBlock Margin="10" Padding="3">It is suggested to paste into a .rb file for syntax coloring and easy editing.</TextBlock>
        </StackPanel>
    </Grid>
</Window>
