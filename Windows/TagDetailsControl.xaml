<UserControl x:Class="Filterizer2.Windows.TagDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Filterizer2.Windows"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border x:Name="TagDetailsBorder"  BorderThickness="1" Padding="10" CornerRadius="5">

        <StackPanel>
            <TextBlock x:Name="TagTitleTextBlock"
                       FontWeight="Bold"
                       FontSize="16"/>

            <TextBlock x:Name="TagDescriptionTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TagAliasesTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TagParentsTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

    </Border>
</UserControl>