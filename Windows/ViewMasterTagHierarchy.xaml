<filterizer2:FilterizerWindow x:Class="Filterizer2.Windows.ViewMasterTagHierarchy"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:local="clr-namespace:Filterizer2.Windows"
                              xmlns:filterizer2="clr-namespace:Filterizer2"
                              mc:Ignorable="d"
                              Title="ViewMasterTagHierarchy" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="300"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!-- <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="DarkGray"> -->
        <TreeView x:Name="TagsHierarchy" MinHeight="200" BorderThickness="0" ScrollViewer.CanContentScroll="True"
                  SelectedItemChanged="TagsListBox_OnSelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding GetChildren}">
                    <Border BorderThickness="1" Padding="1">
                        <Border.Resources>
                            <Style x:Key="MenuItemStyle" TargetType="MenuItem">
                                <EventSetter Event="Click" Handler="GoToMenuItem_OnClick"/> 
                            </Style>
                            
                            <ContextMenu x:Key="TagJumpMenu">
                                <MenuItem Header="Find original" 
                                          CommandParameter="{Binding}" 
                                          Name="GoToParent" 
                                          Style="{StaticResource MenuItemStyle}"/>
                            </ContextMenu>
                        </Border.Resources>
                        <TextBlock Text="{Binding GetTitle}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- default for primary -->
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{Binding GetColor}"/>
                                    <Setter Property="FontWeight" Value="800"/>
                                    
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPrimary}" Value="False">
                                            <Setter Property="FontSize" Value="10"/>
                                            <!-- <Setter Property="Foreground" Value="Gray"/> -->
                                            <Setter Property="FontWeight" Value="400"/>
                                            <Setter Property="ContextMenu" Value="{StaticResource TagJumpMenu}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <!-- </ScrollViewer> -->
        <Border Grid.Column="1" Name="TagDetailsBorder" BorderBrush="Gray" BorderThickness="2" Margin="20" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Name="TagTitleTextBlock" FontWeight="Bold" FontSize="16" />
                <TextBlock Name="TagDescriptionTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Name="TagParentsTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</filterizer2:FilterizerWindow>
