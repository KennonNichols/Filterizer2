<Window x:Class="Filterizer2.Windows.MainWindow"
        x:Name="Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf"
        xmlns:filterizer2="clr-namespace:Filterizer2"
        Title="Filterizer2" Height="675" Width="1200"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        KeyDown="Window_KeyDown"
        MouseMove="MainWindow_OnMouseMove"
        >
    <Window.Resources>
        <!-- DataTemplate for MediaItem -->
        <DataTemplate x:Key="MediaItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding DisplayThumbnailPath}" Width="64" Height="64" Margin="5" />
                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" Margin="5" />
            </StackPanel>
        </DataTemplate>

        <!-- DataTemplate for AlbumItem -->
        <DataTemplate x:Key="AlbumItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Background="LightBlue" Padding="5">
                    <Image Source="{Binding DisplayThumbnailPath}" Width="64" Height="64" Margin="5" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" VerticalAlignment="Center" Margin="5" />
                    <TextBlock Text="Album" Foreground="Gray" VerticalAlignment="Center" Margin="5" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <filterizer2:MediaItemTemplateSelector x:Key="MediaItemTemplateSelector"
                                               MediaItemTemplate="{StaticResource MediaItemTemplate}"
                                               AlbumItemTemplate="{StaticResource AlbumItemTemplate}" />
    </Window.Resources>
    
    
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="MetaToolbarRowDefinition"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="MetaToolbar" Orientation="Horizontal" Grid.Row="0" Margin="10" Height="30">
            <Button x:Name="LoadMediaButton" Content="Discover Media" Width="100" Click="LoadMediaButton_Click"/>
            <Button x:Name="CreateAlbumButton" Content="Create Album" Width="100" Margin="10,0,0,0" Click="CreateAlbumButton_Click"/>
            <Button x:Name="FilterButton" Content="Filter By Tags" Width="100" Margin="10,0,0,0" Click="FilterButton_Click"/>
            <Button x:Name="ViewDictionaryButton" Content="Tag Dictionary" Click="OpenTagDictionaryButton_Click" Width="100" Margin="10, 0, 0, 0"/>
            <StackPanel Orientation="Vertical" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Height="15">
                    <ToggleButton Height="10" Width="10" IsChecked="True" x:Name="ShowMediaCheckbox" Click="VisibilityButtonChecked"/>
                    <TextBlock Margin="10,0,0,0">Show media</TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="15">
                    <ToggleButton Height="10" Width="10" x:Name="ShowAlbumsCheckbox" Click="VisibilityButtonChecked"/>
                    <TextBlock Margin="10,0,0,0">Show albums</TextBlock>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10,0,0,0" Visibility="Collapsed" x:Name="AlbumDupePanel">
                <StackPanel Orientation="Horizontal" Height="15">
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="15" ToolTip="Makes it so that media that are contained within an album (that is loaded in the selection) are not shown in the selection.">
                    <ToggleButton Height="10" Width="10" IsChecked="True" x:Name="PreventAlbumDuplicatesCheckbox" Click="VisibilityButtonChecked"/>
                    <TextBlock Margin="10,0,0,0">No duplicates</TextBlock>
                </StackPanel>
            </StackPanel>
            <ComboBox x:Name="SorterSelectorBox" Width="130" Height="25" SelectionChanged="SorterSelectorBox_SelectionChanged" Margin="10,0, 0,0">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrush}"/>
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="ThemeSelectorBox" Width="65" Height="25" SelectionChanged="ThemeSelectorBox_SelectionChanged" Margin="10,0, 0,0">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" />
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MediaListBoxColumnDefinition" Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <ListBox x:Name="MediaListBox" Grid.Column="0" ItemTemplateSelector="{StaticResource MediaItemTemplateSelector}" SelectionChanged="MediaListBox_SelectionChanged" LayoutUpdated="AnyBearingPanel_OnSizeChanged"></ListBox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto" x:Name="MediaControlPanelRowDefinition"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" x:Name="MediaBorder" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <wpf:VlcControl x:Name="VlcPlayer" Visibility="Hidden" />
                        <Image x:Name="ImageView" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                
                <StackPanel Orientation="Vertical" Grid.Row="1" x:Name="MediaControlPanel">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Fullscreen" Name="MediaFullscreenButton" IsEnabled="True" Margin="20,5,10,5" Click="MediaFullscreenButton_OnClick"/>
                        <StackPanel Orientation="Horizontal" x:Name="MediaTray">
                            <Button Content="Edit" Name="EditMediaButton" IsEnabled="False" Margin="20,5,10,5" Click="EditMediaButton_Click"/>
                            <Button Content="Delete" Name="DeleteMediaButton" IsEnabled="False" Margin="20,5,10,5" Click="DeleteMediaButton_Click"/>
                            <Button Content="Find File" Name="FileExplorerButton" IsEnabled="False" Margin="20,5,10,5" Click="FileExplorerButton_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel x:Name="ControlTray" Orientation="Horizontal" Background="Gray" Height="50" VerticalAlignment="Bottom" Visibility="Collapsed">
                        <Button Content="Play" x:Name="TogglePlayButton" Click="TogglePlayButton_Click" Margin="5" />
                        <Button Content="&lt;&lt; 10s" Click="RewindButton_Click" Margin="5" />
                        <Button Content="&gt;&gt; 10s" Click="ForwardButton_Click" Margin="5" />
                            
                        <!-- Seek bar -->
                        <Slider x:Name="VideoSeekBar" Width="200" Margin="5" PreviewMouseDown="SeekBar_PreviewMouseDown" PreviewMouseUp="SeekBar_PreviewMouseUp" ValueChanged="VideoSeekBar_ValueChanged"/>
            
                        <!-- Timestamp -->
                        <TextBlock x:Name="TimerText" Margin="5" VerticalAlignment="Center" Width="100" Text="00:00 / 00:00"/>
                        
                          
                        <!-- Volume bar -->
                        <Slider x:Name="VolumeBar" Width="200" Margin="5" ValueChanged="VolumeBar_OnValueChanged" Value="100" Maximum="200" TickPlacement="BottomRight" TickFrequency="100" IsSnapToTickEnabled="False"/>

                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Name="AlbumTray" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&lt;" Name="LeftButton" Margin="20,5,10,0" Click="LeftButton_Click"/>
                            <Button Content="&gt;" Name="RightButton" IsEnabled="False" Margin="20,5,10,0" Click="RightButton_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Edit Album" Name="EditAlbumButton" Margin="20,5,10,0" Click="EditAlbumButton_Click"/>
                            <Button Content="Delete Album" Name="DeleteAlbumButton" IsEnabled="False" Margin="20,5,10,0" Click="DeleteAlbumButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
