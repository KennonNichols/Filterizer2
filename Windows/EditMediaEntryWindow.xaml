<filterizer2:FilterizerWindow x:Class="Filterizer2.Windows.EditMediaEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf"
        xmlns:windows="clr-namespace:Filterizer2.Windows"
        xmlns:controls="clr-namespace:Filterizer2.Controls"
        xmlns:filterizer2="clr-namespace:Filterizer2"
        x:Name="EditMediaWindow"
        
        Title="New Media Entry" Height="900" Width="800">
    <filterizer2:FilterizerWindow.Resources>
        <!-- The Proxy "captures" the Window's context -->
        <windows:BindingProxy x:Key="WindowProxy" Data="{Binding ElementName=EditMediaWindow}" />
    </filterizer2:FilterizerWindow.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Enter Title:" Margin="5"/>
            <TextBox x:Name="TitleTextBox" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="Enter Description:" Margin="5"/>
            <TextBox x:Name="DescriptionTextBox" Margin="5"/>
        </StackPanel>

        <!-- Media Preview Area -->
        <Border Grid.Row="2" Background="Gray" Margin="5" CornerRadius="5" Padding="10">
            <controls:MediaMultiplayerControl x:Name="MediaPlayer"/>
            <!-- <Grid> -->
            <!--     <wpf:VlcControl x:Name="VlcPlayer" Visibility="Collapsed" /> -->
            <!--     <Image x:Name="ImageView" Visibility="Collapsed"/> -->
            <!--     <MediaElement x:Name="VideoPlayer" Visibility="Collapsed"/> -->
            <!-- </Grid> -->
        </Border>
        
        
        <StackPanel Grid.Row="3" Margin="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Name="TagSearchTextBox" Width="200"  TextChanged="TagSearchTextBox_TextChanged"/>
                <Button Content="Open tag dictionary" Margin="5, 0, 0, 0" Click="OpenTagDictionaryButton_Click" Padding="2"></Button>
                <Button Content="Open advanced tagger" Margin="5, 0, 0, 0" Click="OpenAdvancedTaggerButton_Click" Padding="2"></Button>
                <Button Content="Toggle delete mode" Margin="5, 0, 0, 0" Click="ToggleDelete_OnClick" Padding="2"></Button>
            </StackPanel>

            <ListBox Name="TagSearchResultsListBox" Height="80" SelectionMode="Single" MouseLeftButtonUp="TagSearchResultsListBox_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding DisplayColorBrush}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="80" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding CurrentTags}" Name="CurrentTagsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Description}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding DisplayColorBrush}"/>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.ContextMenu>
                                        <ContextMenu Name="CustomTextBlockMenu">
                                            <MenuItem Header="View in hierarchy" CommandParameter="{Binding}" Name="OpenHierarchyViewMenuItem" Click="OpenHierarchyViewMenuItem_OnClick"/>
                                            <MenuItem Header="Delete tag" 
                                                      CommandParameter="{Binding}" 
                                                      IsEnabled="{Binding Source={StaticResource WindowProxy}, Path=Data.IsDeleteMode}" 
                                                      Click="RemoveTagButton_Click"/>
                                            <!-- <MenuItem Header="Delete tag" CommandParameter="{Binding}" IsEnabled="{Binding ElementName=EditMediaWindow, Path=IsDeleteMode, Mode=OneWay }" Click="RemoveTagButton_Click"/> -->
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                                <!-- <Button Content="x" Width="20" Height="20" Margin="5,0,0,0"  -->
                                <!--         CommandParameter="{Binding}" IsEnabled="{Binding ElementName=EditMediaWindow, Path=IsDeleteMode, Mode=OneWay }" Click="RemoveTagButton_Click"/> -->
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Width="100" Margin="5" Click="SaveButton_Click"/>
            <!--<Button x:Name="CancelButton" Content="Cancel" Width="100" Margin="5" Click="CancelButton_Click"/>-->
        </StackPanel>
    </Grid>
</filterizer2:FilterizerWindow>