<Window x:Class="Filterizer2.Windows.MediaTaggingHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Filterizer2.Windows"
        xmlns:controls="clr-namespace:Filterizer2.Controls"
        mc:Ignorable="d"
        Title="Media Tagging Helper"
        Height="850"
        Width="1400"
        WindowStartupLocation="CenterOwner" d:DataContext="{d:DesignInstance Type=windows:MediaTaggingHelperWindow, IsDesignTimeCreatable=False}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#2D2D30"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,8">
            <TextBlock x:Name="HeaderTextBlock"
                       Text="Category > Subcategory"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Subcategory description + confirm button -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Grid.Column="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F5F5F5"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,12,0">
                <TextBlock x:Name="SubcategoryDescriptionTextBlock"
                       Text="Description goes here."
                       TextWrapping="Wrap"/>
            </Border>

            <Button x:Name="ConfirmSubcategoryButton"
                    Grid.Column="1"
                    Content="Confirm &amp; Next"
                    Width="170"
                    Height="60"
                    FontWeight="Bold"
                    IsDefault="True"
                    Click="ConfirmSubcategoryButton_Click"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search -->
            <Border Grid.Column="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Search Tags"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="1"
                             Height="32"
                             Margin="0,0,0,8"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <ListBox x:Name="SearchListBox"
                             Grid.Row="2"
                             ItemsSource="{Binding SearchResults}"
                             SelectionChanged="SearchListBox_SelectionChanged"
                             MouseDoubleClick="SearchListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Tag.Name}"
                                        Foreground="{Binding Foreground}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CENTER: Queue, children, details -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Queue -->
                <Border Grid.Row="0"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="QueueHeader" Text="Queue (Current Subcategory)"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="QueueListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding QueueTags}"
                                 SelectionChanged="QueueListBox_SelectionChanged"
                                 MouseDoubleClick="QueueListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                          Text="{Binding Tag.Name}"
                                          Foreground="{Binding Foreground}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Children -->
                <Border Grid.Row="1"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ChildListHeader" Text="Children of Selected Queue Tag"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="Gray"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="ChildListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding ChildOfQueue}"
                                 
                                 SelectionChanged="ChildListBox_SelectionChanged"
                                 MouseDoubleClick="ChildListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Tag.Name}"
                                        Foreground="{Binding Foreground}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Tag details -->
                
                <windows:TagDetailsControl Grid.Row="2" x:Name="TagDetails" DefaultBorderBrush="#D0D0D0"/>
            </Grid>

            <!-- RIGHT: Master list + media preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!-- Master list -->
                <Border Grid.Row="0"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Selected Tags (Master List)"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="MasterListBox"
                                 ItemsSource="{Binding MasterTags}"
                                 Grid.Row="1"
                                 SelectionChanged="MasterListBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Media preview placeholder -->
                <Border Grid.Row="1"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Media Preview"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,8"/>
                        
                        <!-- <Border x:Name="MediaPreviewHost" -->
                        <!--         Grid.Row="1" -->
                        <!--         Background="#1E1E1E" -->
                        <!--         CornerRadius="6" -->
                        <!--         BorderBrush="#555" -->
                        <!--         BorderThickness="1"> -->
                        <!--     <Grid> -->
                        <!--          -->
                        <!--         <TextBlock Text="Add media player here" -->
                        <!--                    Foreground="#AAAAAA" -->
                        <!--                    FontStyle="Italic" -->
                        <!--                    HorizontalAlignment="Center" -->
                        <!--                    VerticalAlignment="Center"/> -->
                        <!--     </Grid> -->
                        <!-- </Border> -->
                        
                        <Border x:Name="MediaPreviewHost"
                                Grid.Row="1"
                                Background="#1E1E1E"
                                CornerRadius="6"
                                BorderBrush="#555"
                                BorderThickness="1">
                            <Grid>
                                <controls:MediaMultiplayerControl x:Name="MediaPlayer"/>
                            </Grid>
                        </Border>
                        
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>